BOOKING_SERVICE_HOST=0.0.0.0
BOOKING_SERVICE_PORT=50051
BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking
BOOKING_DB_PASSWORD=booking_password
BOOKING_DB_DSN=postgres://booking:booking_password@booking_db:5432/booking_db?sslmode=disable
AVAILABILITY_SERVICE_TARGET=availability-service:50051
PAYMENT_SERVICE_TARGET=payment-service:50051
BOOKING_EXTERNAL_CALL_TIMEOUT=3s
BOOKING_SAGA_MAX_RETRIES=3
BOOKING_SAGA_RETRY_DELAY=200ms

PAYMENTS_DB_USER=postgres
PAYMENTS_DB_PASSWORD=postgres
PAYMENTS_DB_NAME=payments_db

AVAILABILITY_DB_USER=postgres
AVAILABILITY_DB_PASSWORD=postgres
AVAILABILITY_DB_NAME=availability_db
AVAILABILITY_SERVICE_PORT=50051
AVAILABILITY_SHARDING_ENABLED=true
AVAILABILITY_PARTITION_COUNT=16
AVAILABILITY_SHARDS=shard0,shard1
AVAILABILITY_PARTITION_MAP=0:shard0,1:shard0,2:shard0,3:shard0,4:shard0,5:shard0,6:shard0,7:shard0,8:shard1,9:shard1,10:shard1,11:shard1,12:shard1,13:shard1,14:shard1,15:shard1
AVAILABILITY_SHARD0_DSN=postgres://postgres:postgres@availability-db-shard-0:5432/availability_db?sslmode=disable
AVAILABILITY_SHARD1_DSN=postgres://postgres:postgres@availability-db-shard-1:5432/availability_db?sslmode=disable

PAYMENT_SERVICE_PORT=50051

API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8080
API_GATEWAY_REQUEST_TIMEOUT=5s
BOOKING_SERVICE_TARGET=booking-service:50051
AUTH_SERVICE_TARGET=auth-service:50051

FRONTEND_PORT=5173
VITE_API_BASE_URL=/api

# Auth Service
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=50051
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth_password
AUTH_DB_DSN=postgres://auth:auth_password@auth_db:5432/auth_db?sslmode=disable
JWT_SECRET=medconnect-jwt-secret-change-me
