# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=availability-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=availability_db

# ── Servidor gRPC ─────────────────────────────────────────────────────────────
GRPC_PORT=50051

# ── Sharding opcional ────────────────────────────────────────────────────────
# Por defecto el servicio usa la DB única configurada arriba.
AVAILABILITY_SHARDING_ENABLED=false
# Si se habilita sharding y no se define este valor, el servicio usa 16 particiones lógicas.
# AVAILABILITY_PARTITION_COUNT=16
# Lista de shards físicos y asignación partición→shard.
# AVAILABILITY_SHARDS=shard0,shard1
# AVAILABILITY_PARTITION_MAP=0:shard0,1:shard1,2:shard0,3:shard1
# DSN por shard: el nombre se forma como AVAILABILITY_<SHARD_EN_MAYUSCULAS>_DSN.
# AVAILABILITY_SHARD0_DSN=postgres://postgres:postgres@availability-shard0:5432/availability_db?sslmode=disable
# AVAILABILITY_SHARD1_DSN=postgres://postgres:postgres@availability-shard1:5432/availability_db?sslmode=disable
